# Editor
export EDITOR="nvim"
export VISUAL="nvim"
export SUDO_EDITOR="nvim"

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

# ── Completions (fpath + cache must come before compinit) ─────────────────────
# `brew install zsh-completions` covers 300+ tools automatically
if command -v brew &>/dev/null; then
    fpath+=("$(brew --prefix)/share/zsh-completions" "$(brew --prefix)/share/zsh/site-functions")
fi

# Cache generated completions — only regenerates when the binary is updated
_ZSH_COMP_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
mkdir -p "$_ZSH_COMP_CACHE"
fpath+=("$_ZSH_COMP_CACHE")

_cache_completion() {
    local cmd="$1"; shift
    command -v "$cmd" &>/dev/null || return
    local f="$_ZSH_COMP_CACHE/_${cmd}"
    [[ -f "$f" && "$(command -v $cmd)" -ot "$f" ]] && return
    "$@" > "$f" 2>/dev/null || rm -f "$f"
}

# ── Add/remove lines here to enable completions for more tools ────────────────
_cache_completion uv       uv generate-shell-completion zsh
_cache_completion uvx      uvx --generate-shell-completion zsh
_cache_completion gh       gh completion -s zsh
_cache_completion docker   docker completion zsh
_cache_completion kubectl  kubectl completion zsh
_cache_completion helm     helm completion zsh
_cache_completion rustup   rustup completions zsh
_cache_completion cargo    rustup completions zsh cargo
_cache_completion chezmoi  chezmoi completion zsh
_cache_completion op       op completion zsh
_cache_completion poetry   poetry completions zsh
_cache_completion deno     deno completions zsh
_cache_completion just     just --completions zsh
_cache_completion mise     mise completion zsh
_cache_completion atuin    atuin gen-completions --shell zsh
_cache_completion fly      fly completion zsh
_cache_completion stripe   stripe completion --shell zsh
# ─────────────────────────────────────────────────────────────────────────────

unset -f _cache_completion
unset _ZSH_COMP_CACHE

autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'  # case-insensitive

# ── fzf (fuzzy CTRL-R history, CTRL-T files, ALT-C dirs) ──────────────────────
if command -v fzf &>/dev/null; then
    # fzf 0.48+ ships its own shell integration
    if fzf --zsh &>/dev/null 2>&1; then
        eval "$(fzf --zsh)"
    elif command -v brew &>/dev/null; then
        _src() { [ -f "$1" ] && source "$1"; }
        _src "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
        _src "$(brew --prefix)/opt/fzf/shell/completion.zsh"
        unset -f _src
    fi
fi

# ── zsh-autosuggestions (fish-like inline grey suggestions) ───────────────────
_src() { [ -f "$1" ] && source "$1" && return 0; return 1; }
if command -v brew &>/dev/null; then
    _src "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# ── zsh-syntax-highlighting (fish-like command colouring) ─────────────────────
# must be sourced last
if command -v brew &>/dev/null; then
    _src "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
unset -f _src

# ── Starship prompt ────────────────────────────────────────────────────────────
command -v starship &>/dev/null && eval "$(starship init zsh)"

# ── zoxide (smart cd — use `z <partial-dir>` instead of cd) ───────────────────
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"
