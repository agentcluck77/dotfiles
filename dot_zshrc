# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

# Completion
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'  # case-insensitive

# ── fzf (fuzzy CTRL-R history, CTRL-T files, ALT-C dirs) ──────────────────────
if command -v fzf &>/dev/null; then
    # fzf 0.48+ ships its own shell integration
    if fzf --zsh &>/dev/null 2>&1; then
        eval "$(fzf --zsh)"
    else
        _src() { [ -f "$1" ] && source "$1"; }
        if command -v brew &>/dev/null; then
            _src "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
            _src "$(brew --prefix)/opt/fzf/shell/completion.zsh"
        else
            # Ubuntu
            _src /usr/share/doc/fzf/examples/key-bindings.zsh
            # Fedora / Arch
            _src /usr/share/fzf/shell/key-bindings.zsh
        fi
        unset -f _src
    fi
fi

# ── zsh-autosuggestions (fish-like inline grey suggestions) ───────────────────
_src() { [ -f "$1" ] && source "$1" && return 0; return 1; }
if command -v brew &>/dev/null; then
    _src "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
else
    _src /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ||           # Ubuntu/Debian
    _src /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh  # Fedora/Arch
fi

# ── zsh-syntax-highlighting (fish-like command colouring) ─────────────────────
# must be sourced last
if command -v brew &>/dev/null; then
    _src "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
else
    _src /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ||           # Ubuntu/Debian
    _src /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh  # Fedora/Arch
fi
unset -f _src

# ── Starship prompt ────────────────────────────────────────────────────────────
command -v starship &>/dev/null && eval "$(starship init zsh)"

# ── zoxide (smart cd — use `z <partial-dir>` instead of cd) ───────────────────
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"
